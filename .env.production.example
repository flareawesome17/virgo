# Virgo production host — environment template.
#
# Copy to `.env` beside docker-compose.prod.yml on the production machine and
# fill in the REPLACE_ME values. Never commit the filled-in copy.
#
#   copy .env.production.example .env
#
# Compose reads `.env` from the directory it runs in, and the api service also
# passes this same file into the container via env_file — so everything the API
# needs belongs here, not only the variables compose interpolates.
#
# Three kinds of line below:
#   • a real value      — correct for production, leave it alone
#   • GENERATE          — make a fresh random secret, never reuse development's
#   • REPLACE_ME        — only you have it; where to get it is noted above each
#
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ── which release runs ────────────────────────────────────────────────────────
# The one variable that decides what is deployed. A published GitHub Release
# tag. Rolling back is editing this line and pulling again.
IMAGE_TAG=v1.0.0

# ── database ──────────────────────────────────────────────────────────────────
# No defaults in compose on purpose: it refuses to start rather than silently
# creating a production database with a guessable password.
#
# virgo_prod, not virgo_dev. Development is a different name on a different
# host, which is what stops a tool being pointed at the wrong one.
POSTGRES_USER=virgo
POSTGRES_PASSWORD=GENERATE
POSTGRES_DB=virgo_prod
# Host-side port, bound to loopback. Only for psql and backups on the machine
# itself; the API reaches Postgres over the compose network.
POSTGRES_PORT=5432

# Inside the container, Postgres is a peer on the compose network and TLS buys
# nothing. Set to `require` only if you move to a managed database.
DATABASE_SSL=disable

# ── ports on the host ─────────────────────────────────────────────────────────
# All loopback-bound. The tunnel is the only ingress.
API_PORT=3001
PGADMIN_PORT=5050

# ── secrets ───────────────────────────────────────────────────────────────────
# Fresh values, not development's. Access and refresh must differ — the API
# refuses to boot if they match, because a refresh token that verifies as an
# access token is a session that never expires.
JWT_ACCESS_SECRET=GENERATE
JWT_REFRESH_SECRET=GENERATE
# The console signs with its own key, so an app token can never be an admin one.
ADMIN_JWT_SECRET=GENERATE

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ── who the API answers ───────────────────────────────────────────────────────
# REQUIRED in production — the API refuses to boot without it. Unset, CORS
# reflects whatever origin asks, which is fine on a laptop and wrong here.
# The last entry is the desktop app (desktop/). It serves the web client from a
# loopback address and calls this API from there, so http://127.0.0.1:41730 is
# the Origin on its requests. The port is fixed in desktop/src-tauri/src/lib.rs
# for exactly this reason — a port picked per launch could never be listed here.
# Changing one without the other breaks every request at the preflight.
CORS_ORIGINS=https://web.virgo.ph,https://virgo.ph,https://www.virgo.ph,https://console.virgo.ph,http://127.0.0.1:41730

# ── public hostnames ──────────────────────────────────────────────────────────
# One per role; see docs/DOMAINS.md. Nothing in the code names a domain
# directly — these are what it reads.

# The public/marketing origin: profiles at /@handle, the job board.
PUBLIC_SITE_URL=https://virgo.ph

# The authenticated browser app. Every link in every email lands here.
WEB_APP_URL=https://web.virgo.ph

# The API's own public origin.
PUBLIC_API_URL=https://api.virgo.ph

# Client delivery — album share links (/s/<token>) sent to people with no Virgo
# account. Both names are read; PUBLIC_APP_URL is the older one, kept so an
# existing deployment does not need editing.
CLIENT_DELIVERY_URL=https://client.virgo.ph
PUBLIC_APP_URL=https://client.virgo.ph

# The management console. Used by the emails the console itself sends.
CONSOLE_URL=https://console.virgo.ph

# ── behaviour ─────────────────────────────────────────────────────────────────
# Sign-in requires a confirmed address. Leave on: it is what stops an account
# being made with an address somebody does not own, and what makes a referral
# reward cost an attacker something.
REQUIRE_EMAIL_VERIFICATION=true

# Days a past schedule event is kept before the nightly sweep deletes it.
EVENT_RETENTION_DAYS=30

# ── storage — Backblaze B2 ────────────────────────────────────────────────────
# From Backblaze → Application Keys. Use a key scoped to these buckets, not the
# master key. Two buckets: avatars are public, media is private and served only
# through signed URLs.
STORAGE_PROVIDER=b2
B2_KEY_ID=REPLACE_ME
B2_APPLICATION_KEY=REPLACE_ME
B2_BUCKET_NAME=REPLACE_ME
B2_MEDIA_BUCKET_NAME=REPLACE_ME
# From the bucket's Endpoint line, e.g. s3.us-west-004.backblazeb2.com
B2_ENDPOINT=REPLACE_ME
# The region inside that endpoint, e.g. us-west-004
B2_REGION=REPLACE_ME
B2_FORCE_PATH_STYLE=false

# Public base URL objects are served from. Leave empty for a private bucket —
# media then goes out through signed URLs, which is the intended arrangement.
CDN_BASE_URL=

# ── media host — media.virgo.ph ───────────────────────────────────────────────
# The one hostname that does NOT go through the tunnel. nginx serves rendition
# bytes from a local volume on :443, because this machine is ~10 ms from a
# Manila viewer and the B2 bucket is ~200 ms. See docs/MEDIA_DELIVERY.md.
#
# Two things must be true outside this file:
#   1. The DNS record is DNS-only — grey cloud, not orange. Proxying it would
#      put media back on a CDN, which is the thing being avoided.
#   2. Port 443 is forwarded to this machine, and the WAN address is static.
#
# Leave MEDIA_HOST empty to turn the whole feature off: no renditions are
# produced and every player falls back to the B2 original, which is what the
# deployment did before any of this existed.
MEDIA_HOST=media.virgo.ph

# Signs playback URLs. nginx verifies with the same value, so the API and the
# media container must agree — changing it invalidates every URL already
# handed out, which for a 24h TTL means a day of broken galleries.
#   openssl rand -base64 36
MEDIA_LINK_SECRET=REPLACE_ME

# Where the rendition volume is mounted inside the API container. Only change
# this alongside the mount in docker-compose.prod.yml.
MEDIA_ROOT=/srv/media

# Where Let's Encrypt sends expiry warnings. A real mailbox someone reads: it
# is the only warning before a certificate lapses and media stops loading.
MEDIA_CERT_EMAIL=REPLACE_ME

# The Cloudflare DNS API token certbot uses for DNS-01 is NOT here — certbot
# wants its own ini file. Copy deployment/media/cloudflare-dns.ini.example to
# `cloudflare-dns.ini` beside docker-compose.prod.yml and fill it in.

# ── email — SMTP2GO ───────────────────────────────────────────────────────────
# From https://app-us.smtp2go.com/sending/smtp_users/. The From domain must be
# verified under Sending → Verified Senders or delivery is rejected.
SMTP_HOST=mail-us.smtp2go.com
SMTP_PORT=2525
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
MAIL_FROM_ADDRESS=noreply@virgo.ph
MAIL_FROM_NAME=Virgo
MAIL_REPLY_TO=support@virgo.ph

# ── billing — PayMongo ────────────────────────────────────────────────────────
# LIVE keys here, not test. The secret key is server-side only; the webhook
# secret is what proves a callback really came from PayMongo.
PAYMONGO_SECRET_KEY=REPLACE_ME
PAYMONGO_WEBHOOK_SECRET=REPLACE_ME
# Where a checkout returns to. Both default to WEB_APP_URL/settings/plans, so
# leave them unset unless you want somewhere else.
# PAYMONGO_RETURN_URL_WEB=
# PAYMONGO_RETURN_URL_MOBILE=

# ── console ───────────────────────────────────────────────────────────────────
# Creates the first owner account on boot if it does not exist, with a random
# password printed once to the container log. Sign in and change it immediately.
ADMIN_EMAIL_SEED=REPLACE_ME

# Treat this as a second database password — pgAdmin is full read/write on
# production data. Put Cloudflare Access in front of db.virgo.ph as well.
PGADMIN_EMAIL=REPLACE_ME
PGADMIN_PASSWORD=GENERATE

# ── ingress ───────────────────────────────────────────────────────────────────
# From Cloudflare Zero Trust → Networks → Tunnels, on the PRODUCTION tunnel.
# Not the development machine's token: the hostnames must be served from here,
# or production traffic keeps arriving at a laptop.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME

# ── analytics (optional) ──────────────────────────────────────────────────────
# Server-side PostHog. The browser's key is baked into the web image at build
# time instead — see docs/DOMAINS.md.
POSTHOG_KEY=

# DATABASE_URL is deliberately absent. docker-compose.prod.yml builds it from
# the POSTGRES_* values above so it always points at the compose network rather
# than at localhost, which inside a container means the container itself.

# ── desktop downloads ─────────────────────────────────────────────────────────
# Lets virgo.ph/download serve the desktop installers attached to a release.
# The repository is private, so without this the download page has nothing to
# offer and says so rather than linking to a 404.
#
# Fine-grained PAT, this repository only, Contents: Read-only. Streamed through
# the API rather than redirected, so the token stays here and the download stays
# on api.virgo.ph.
#
# NOT the deployment worker's token. That one is stored encrypted under
# deployment/windows/secrets by set-github-token.ps1, is readable only by the
# Windows account running the scheduled task, and cannot be read by a container.
# Running that script does nothing for this variable. Keeping them separate also
# means this token — the one exposed to the internet — can be revoked without
# stopping deployments.
GITHUB_DOWNLOADS_TOKEN=REPLACE_ME
