# Virgo production host — environment template.
#
# Copy to `.env` beside docker-compose.prod.yml on the production machine and
# fill in real values. Never commit the filled-in copy; nothing here has a
# default worth shipping.
#
#   copy .env.production.example .env
#
# Compose reads `.env` from the directory it runs in, and the api service also
# passes the same file into the container via env_file. Every variable the API
# itself needs — SMTP, storage, PayMongo, JWT secrets — belongs here too; see
# api/.env.example for that full list.

# ── which release runs ────────────────────────────────────────────────────────
# The one variable that decides what is deployed. Set it to a published GitHub
# Release tag and every Virgo application container comes from that release.
# Rolling back is editing this line and pulling again.
IMAGE_TAG=v1.0.0

# ── database ──────────────────────────────────────────────────────────────────
# No defaults on purpose: compose refuses to start without these rather than
# silently creating a production database with a guessable password.
POSTGRES_USER=virgo
POSTGRES_PASSWORD=
POSTGRES_DB=virgo
# Host-side port, bound to loopback. Only for psql and backups on the machine
# itself; the API reaches Postgres over the compose network.
POSTGRES_PORT=5432

# ── ports on the host ─────────────────────────────────────────────────────────
# All loopback-bound. The tunnel is the only ingress.
API_PORT=3001
PGADMIN_PORT=5050

# ── database console ──────────────────────────────────────────────────────────
# Treat PGADMIN_PASSWORD as a second database password: this console has full
# read/write access. Put Cloudflare Access in front of db.virgo.ph as well.
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# ── ingress ───────────────────────────────────────────────────────────────────
# From the Cloudflare Zero Trust dashboard. Routing for api/web/console/db
# hostnames is configured there, not in the compose file.
CLOUDFLARE_TUNNEL_TOKEN=

# ── everything the API needs ──────────────────────────────────────────────────
# Append the rest from api/.env.example: JWT_ACCESS_SECRET, JWT_REFRESH_SECRET,
# ADMIN_JWT_SECRET, SMTP_*, MAIL_*, B2_*, CDN_BASE_URL, PAYMONGO_*,
# CORS_ORIGINS, PUBLIC_APP_URL, WEB_APP_URL, POSTHOG_KEY.
#
# DATABASE_URL is NOT set here. docker-compose.prod.yml builds it from the
# POSTGRES_* values above so it always points at the compose network rather
# than at localhost, which inside a container means the container itself.
