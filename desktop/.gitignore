# Rust build output.
src-tauri/target/

# Generated by `cargo tauri` on first build.
src-tauri/gen/

# Staged by scripts/stage-web.mjs. Both are build output of `web/`, and the
# Node runtime alone is ~89 MB — this directory is reproducible from a build,
# so none of it belongs in git.
src-tauri/resources/
src-tauri/binaries/

# Generated from web/public/icon.png by `npm run icons`.
src-tauri/icons/
