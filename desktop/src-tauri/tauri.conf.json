{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virgo",
  "version": "1.3.0",
  "identifier": "ph.virgo.desktop",

  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:4123",
    "frontendDist": "../splash"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Virgo",
        "width": 1280,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": null,
        "backgroundColor": "#161311"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },

  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/web": "web"
    },
    "externalBin": ["binaries/node"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
