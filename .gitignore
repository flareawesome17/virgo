node_modules/
.expo/
.tinbase/
dist/

# local env — keep real keys out of git.
# Globbed, not just `.env`: a `.env.backup-…` written during an incident is
# exactly as sensitive and matched none of the old rule.
.env*
!.env.example
# The production template. Placeholders only — the filled-in copy lives on the
# production host and is still caught by the glob above.
!.env.production.example

# The Cloudflare DNS API token certbot uses to answer DNS-01 for the media
# host. Lives beside docker-compose.prod.yml on the production machine; the
# committed version is deployment/media/cloudflare-dns.ini.example.
cloudflare-dns.ini
