# The NestJS API in ../api. Locally the container publishes on host port 3001.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Product analytics. Leave blank and analytics is off — the app does not need
# it to run. The project API key from PostHog (Project settings), not a
# personal key: this one ships to the browser and is meant to be public.
NEXT_PUBLIC_POSTHOG_KEY=
# eu.i.posthog.com for an EU project, us.i.posthog.com for a US one.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
