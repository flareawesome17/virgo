{
  "expo": {
    "name": "Virgo",
    "slug": "virgo",
    "scheme": "virgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.virgo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F4"
      },
      "package": "com.virgo.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F4"
        }
      ]
    ],
    "extra": {
      "defaultAppIconSet": true,
      "selectedIconUrl": "https://sqgedrruthtbkskkjeqa.supabase.co/storage/v1/object/public/projects/e1783080-141a-48df-807b-c02cc168c3fe/fs/assets/images/icon.png?t=1785419567341",
      "selectedIconId": "99aa6d70-970d-42a7-853b-7d05e56e910d"
    }
  }
}