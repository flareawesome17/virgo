{
  "expo": {
    "name": "Virgo",
    "slug": "virgo",
    "owner": "flareawesome",
    "scheme": "virgo",
    "version": "1.3.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.virgo.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.virgo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F4"
      },
      "package": "com.virgo.app",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F4",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#161311"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#B66A40",
                "dark": "#C17745"
              },
              "colorControlActivated": {
                "light": "#B66A40",
                "dark": "#C17745"
              },
              "textColor": {
                "light": "#1E1B18",
                "dark": "#F2EDE8"
              },
              "textColorPrimary": {
                "light": "#1E1B18",
                "dark": "#F2EDE8"
              },
              "textColorSecondary": {
                "light": "#847167",
                "dark": "#948278"
              },
              "windowBackground": {
                "light": "#FFFFFF",
                "dark": "#1E1B18"
              }
            },
            "timePicker": {
              "background": {
                "light": "#FFFFFF",
                "dark": "#1E1B18"
              },
              "headerBackground": {
                "light": "#FFFFFF",
                "dark": "#1E1B18"
              },
              "numbersBackgroundColor": {
                "light": "#FFFFFF",
                "dark": "#1E1B18"
              },
              "numbersTextColor": {
                "light": "#1E1B18",
                "dark": "#F2EDE8"
              },
              "numbersSelectorColor": {
                "light": "#B66A40",
                "dark": "#C17745"
              }
            }
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B66A40"
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Virgo needs access to your photo library so it can save photos and videos from your albums onto this device.",
          "savePhotosPermission": "Virgo saves the photos and videos you download from an album into your device photo library.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Virgo opens your photo library so you can choose photos and videos to upload to an album, or a picture for your profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Virgo uses your location to show you creatives nearby, and to let people near you find you while you share it in Nearby."
        }
      ],
      "expo-build-properties"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F4",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#161311"
      }
    },
    "extra": {
      "eas": {
        "projectId": "280a9b7e-6f27-49df-991f-12bee641dc40"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/280a9b7e-6f27-49df-991f-12bee641dc40",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
