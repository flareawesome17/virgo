# ── Server ──
PORT=3000
NODE_ENV=development

# ── Database ──
# Matches docker-compose.yml defaults. Only used when running the API directly
# on the host; inside Docker the API connects to postgres:5432 over the compose
# network instead.
# Development is virgo_dev; production is virgo_prod, on its own host and
# volume. The compose file overrides this for the api container — this value
# is what anything you run outside compose uses (migrate CLI, psql, tooling).
DATABASE_URL=postgresql://virgo:virgo_dev_password@localhost:5432/virgo_dev
# Set to "require" when pointing at a managed Postgres (Neon, RDS, Railway).
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# ── Auth ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ── CORS ──
# Comma-separated origins allowed to call the API. Matched as exact strings, so
# scheme, host and port must all line up — http://localhost:3005 does not cover
# http://192.168.1.10:3005.
#
# Native builds send no Origin header, so this governs browsers only: the
# Next.js app in web/, the console in dashboard/, and Expo Web.
#
# This file is the *development* template. The values below are, in order: web
# (local, LAN), console (local, LAN), Expo Web (local, LAN), Expo Web's legacy
# port, and Metro over the development tunnel. Replace 192.168.1.10 with this
# machine's LAN address, and drop the tunnel entry if you are not using one.
# Production names its own origins in .env.production — never web.virgo.ph or
# any other production hostname here.
#
# The API is deliberately absent from its own list. It serves the share gallery
# server-rendered with no fetch calls, so that page is same-origin. Note also
# that this list is consulted before an admin password-reset link is pointed at
# a request's Origin, so an entry is a trust decision, not just convenience.
CORS_ORIGINS=http://localhost:3005,http://192.168.1.10:3005,http://localhost:3002,http://192.168.1.10:3002,http://localhost:8081,http://192.168.1.10:8081,http://localhost:19006,https://mobile-dev.virgo.ph

# Baked into the web app at image build time (NEXT_PUBLIC_* is inlined, not
# read at runtime). Change it and rebuild, not restart.
WEB_API_URL=https://api.virgo.ph

# ── Cloudflare Tunnel ──
# Token from the Cloudflare Zero Trust dashboard (Networks > Tunnels).
# Routing lives in the dashboard, not in docker-compose.yml.
CLOUDFLARE_TUNNEL_TOKEN=
# Set true ONLY when the API sits behind the tunnel, so Express reads the real
# client IP from X-Forwarded-For. Leave false for direct local access —
# trusting the header when anyone can reach the port lets callers forge their IP.
TRUST_PROXY=false

# ── Object storage: Backblaze B2 (S3-compatible) ──
# Uploads use presigned URLs, so file bytes never pass through this server.
STORAGE_PROVIDER=b2
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# e.g. https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
# e.g. us-west-004
B2_REGION=
# Public base URL objects are served from. Leave empty for a private bucket
# and use POST /storage/download-url instead.
CDN_BASE_URL=
# Only set true if B2 rejects virtual-hosted-style requests.
B2_FORCE_PATH_STYLE=false

# ─── Public hostnames ───────────────────────────────────────────────────────
# One variable per role. Nothing in the code should name a domain directly;
# these are what it reads.

# Client delivery — album share links (/s/<token>) sent to people who have no
# Virgo account. CLIENT_DELIVERY_URL is the current name; PUBLIC_APP_URL is
# the older one and still honoured, so a running stack does not need editing.
CLIENT_DELIVERY_URL=https://client.virgo.ph
PUBLIC_APP_URL=https://client.virgo.ph

# The public/marketing origin — profiles at /@handle and the job board.
# Used for the links in emails that point at public pages.
PUBLIC_SITE_URL=https://virgo.ph

# The management console. Used in the emails the console itself sends
# (admin invitations, password resets for console accounts).
CONSOLE_URL=https://console.virgo.ph

# Days a past schedule event is kept before the nightly sweep deletes it.
# Defaults to 30 when unset or invalid.
EVENT_RETENTION_DAYS=30

# ─── Email (SMTP2GO) ────────────────────────────────────────────────────────
# Credentials come from https://app-us.smtp2go.com/sending/smtp_users/ —
# create an SMTP user there, then paste its username and password here.
#
# Ports: 2525, 587, 80 and 8025 are plain with STARTTLS; 465, 8465 and 443 are
# implicit TLS. SMTP_SECURE is derived from the port, so it only needs setting
# if you are on a non-standard one.
SMTP_HOST=mail-us.smtp2go.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURE=false

# The From on every message. The domain must be verified in SMTP2GO under
# Sending > Verified Senders, or delivery is rejected.
MAIL_FROM_ADDRESS=noreply@virgo.ph
MAIL_FROM_NAME=Virgo
MAIL_REPLY_TO=support@virgo.ph

# Where the links in emails land. The *web app*, not PUBLIC_APP_URL — that one
# is client.virgo.ph, the public gallery sent to clients, which has no
# /reset-password to land on.
#
# Locally, point it at the dev server so the link is clickable:
#   WEB_APP_URL=http://localhost:3005
WEB_APP_URL=https://web.virgo.ph

# Blocks writes from accounts that have not confirmed their email. Reads and
# signing in are unaffected — the point is to establish the address is real,
# not to lock people out of an account they just made.
#
# Set to false while the sending domain is still unverified with the mail
# provider, or nobody can complete a signup.
REQUIRE_EMAIL_VERIFICATION=true
